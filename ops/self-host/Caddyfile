{$GEOAI_PUBLIC_HOST} {
	encode zstd gzip

	request_body {
		max_size 2MB
	}

	log {
		output file /var/log/caddy/access.log {
			mode 0600
			roll_size 25MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format filter {
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>uri query {
				delete code
				delete token
				delete invitation
				delete access_token
				delete refresh_token
			}
			wrap json
		}
	}

	reverse_proxy app:3000 {
		lb_retries 0
		health_uri /api/health
		health_interval 30s
		health_timeout 5s
		transport http {
			dial_timeout 5s
			response_header_timeout 130s
			keepalive 30s
		}
	}
}
