  },
  "parentSchemas": {
    "canonical": "urn:geoai:schema:place-object-evidence-response:0.3.0",
    "prototype": "urn:geoai:schema:live-point-evidence-response:0.1.0",
    "profile": "POINT_TO_OBJECT_001/1.0.1",
    "profileRule": "This contract is a narrow point-only implementation profile, not a byte-for-byte subset of either parent."
  },
  "scope": {
    "locatorKinds": ["point"],
    "runtimeIdentitySources": ["SPAT-001"],
    "runtimeSourcePolicy": "one immutable source-isolated OSM snapshot per enabled AOI",
    "overtureRole": "offline_evaluation_only",
    "mapboxRole": "presentation_only_not_evidence",
    "openAiRole": "optional_post-validation_narrative_only",
    "excluded": ["official parcel", "cadastre", "ownership", "zoning", "planning approval", "valuation", "routing time", "public REST", "MCP", "customer data", "Production"]
  },
  "enumerations": {
    "operation": ["resolve_entity", "get_context", "get_evidence_bundle"],
    "selectionIntent": ["general_object", "building", "road", "poi", "land_use"],
    "identityStatus": ["resolved", "ambiguous", "coordinate_context_only", "no_result", "outside_coverage"],
    "evidenceQuality": ["sufficient_for_open_context", "partial_open_context", "insufficient_evidence", "blocked_by_rights", "blocked_by_identity", "blocked_by_conflict"],
    "contextState": ["complete", "partial", "not_requested", "not_available"],
    "rightsState": ["cleared", "limited", "unknown", "blocked", "not_evaluated"],
    "executionStatus": ["completed", "partial"],
    "errorEnvelopeStatus": ["invalid_input", "source_unavailable", "blocked", "failed"],
    "errorCode": ["INVALID_REQUEST", "INVALID_COORDINATE", "COORDINATE_ORDER_SUSPECTED", "INPUT_LIMIT_EXCEEDED", "ANCHOR_MISMATCH", "SNAPSHOT_MISSING", "SNAPSHOT_CORRUPT", "SNAPSHOT_HASH_MISMATCH", "SNAPSHOT_INDEX_UNAVAILABLE", "GEOMETRY_NOT_FOUND", "GEOMETRY_HASH_MISMATCH", "CANDIDATE_SET_OVERFLOW", "RIGHTS_UNKNOWN", "RIGHTS_BLOCKED", "SOURCE_STALE_BLOCKED", "PREVIEW_DISABLED", "PRODUCTION_DENIED", "ACCESS_DENIED", "CONTRACT_VALIDATION_FAILED", "INTERNAL_ERROR"],
    "warningCode": ["BOUNDARY_CONTACT", "PARTIAL_CONTEXT_SOURCE", "SOURCE_FRESHNESS_UNKNOWN", "SOURCE_STALE", "SOURCE_CONFLICT", "CONTEXT_TRUNCATED", "CENTROID_FALLBACK", "MODEL_FALLBACK", "COORDINATE_CONTEXT_ONLY", "UNNAMED_SOURCE_FEATURE", "MISSING_IS_NOT_ABSENCE"],
    "categoryObservationState": ["observed", "not_observed_in_source_snapshot", "coverage_unknown", "source_unavailable"]
  },
  "separationRules": [
    "insufficient_evidence is evidence quality, never identity status",
    "source/system/rights failures return an error envelope with identityStatus=null",
    "no_result is allowed only after a healthy cleared snapshot and exact in-coverage search",
    "rightsState must equal cleared for every source used by a success envelope",
    "missing source records never support a real-world absence conclusion"
  ],
  "request": {
    "required": ["operation", "selectionIntent", "locator", "locale", "requestedContextCategories", "requestedRadiusM"],
    "locator": {
      "kind": "point",
      "longitude": "finite number in [-180,180]",
      "latitude": "finite number in [-90,90]",
      "crs": "EPSG:4326",
      "coordinateOrder": "named fields only; arrays and silent swapping prohibited",
      "rawNumbersPreserved": true
    },
    "optionalCandidateAssertion": {
      "candidateId": "server-issued opaque/canonical ID from the same snapshot",
      "selectionReceiptId": "required when candidateId is supplied",
      "serverRevalidationRequired": true
    },
    "caps": { "maximumCandidates": 20, "maximumReturnedFacilities": 100, "maximumCategories": 20, "maximumRadiusM": 1500 }
  },
  "responseDimensions": {
    "identity": "one identityStatus or null only for typed failure",
    "evidence": "one evidenceQuality independent of identity",
    "context": "one contextState independent of identity",
    "rights": "per source and operation",
    "execution": "success or typed error envelope",
    "warnings": "finite list; warnings cannot upgrade evidence"
  },
  "selectedObjectRequiredFields": ["entityId", "entityHashSha256", "sourceId", "sourceFeatureId", "sourceSnapshotId", "featureClass", "authorityStatus", "geometry", "geometryVersion", "geometryHashSha256", "relationshipToClick", "fieldProvenance", "rightsDecisionId", "warnings"],
  "sourceFeature": {
    "schemaVersion": "LivePointSnapshotFeatureV2/1.0.0",
    "required": ["id", "bbox", "geometry", "properties.sourceId", "properties.sourceFeatureId", "properties.sourceSnapshotId", "properties.sourceReleaseId", "properties.featureClass", "properties.identityEligibility", "properties.geometryHashSha256", "properties.rightsState", "properties.permissionPhase", "properties.officialStatus", "properties.missingDoesNotMeanAbsent", "properties.mandatoryCaveat"],
    "sourceFeatureVersionNullable": true,
    "sourceFeatureObservedAtUtcNullable": true,
    "nullMetadataWarning": "SOURCE_FRESHNESS_UNKNOWN",
    "tagProjectionPolicy": "geoai-p2o-osm-tag-allowlist/1.0.0",
    "arbitraryRawTagUseAllowed": false,
    "untrustedText": true,
    "buildingDoesNotMeanParcel": true
  },
  "snapshotManifestRequiredFields": ["absenceClaimAtDefaultRadiusAllowed", "acquisition", "acquisitionReceipt", "activationState", "anchor", "attribution", "calculationCrs", "caseId", "casePackId", "caseRole", "contextCompletenessAtContainedRadius", "counts", "coverageBboxWgs84", "coverageGeometry", "coverageGeometryHashSha256", "defaultContextCoverageState", "defaultRequestedContextRadiusM", "files", "geometryQuality", "knownAnchorInterpretation", "mandatoryCaveat", "manifestVersion", "maxRadiusContainedWithinQueryBboxAtAnchorM", "minimizationTool", "nonCircularManifestHash", "normalizationReceipt", "normalizationTool", "normalizedSnapshot", "officialStatus", "pathBases", "protocol", "query", "retainedFeatureGeometryMayExtendOutsideCoverage", "retainedGeometryExtentWgs84", "rightsDecision", "sourceDatabaseObservedAtUtc", "sourceFeatureMetadataAvailability", "sourceId", "sourceNamespace", "sourceOffer", "sourceReleaseId", "sourceSnapshotId", "spatialIndex", "taxonomyVersions"],
  "snapshotManifestSchema": {
    "schemaVersion": "POINT_TO_OBJECT_001_CASE_PACK_MANIFEST_SCHEMA/1.0.0",
    "additionalTopLevelPropertiesAllowed": false,
    "requiredTopLevelFields": ["absenceClaimAtDefaultRadiusAllowed", "acquisition", "acquisitionReceipt", "activationState", "anchor", "attribution", "calculationCrs", "caseId", "casePackId", "caseRole", "contextCompletenessAtContainedRadius", "counts", "coverageBboxWgs84", "coverageGeometry", "coverageGeometryHashSha256", "defaultContextCoverageState", "defaultRequestedContextRadiusM", "files", "geometryQuality", "knownAnchorInterpretation", "mandatoryCaveat", "manifestVersion", "maxRadiusContainedWithinQueryBboxAtAnchorM", "minimizationTool", "nonCircularManifestHash", "normalizationReceipt", "normalizationTool", "normalizedSnapshot", "officialStatus", "pathBases", "protocol", "query", "retainedFeatureGeometryMayExtendOutsideCoverage", "retainedGeometryExtentWgs84", "rightsDecision", "sourceDatabaseObservedAtUtc", "sourceFeatureMetadataAvailability", "sourceId", "sourceNamespace", "sourceOffer", "sourceReleaseId", "sourceSnapshotId", "spatialIndex", "taxonomyVersions"],
    "pathBases": {
      "files": "case_pack_directory",
      "rightsDecision": "repository_root",
      "sourceOffer": "repository_root",
      "tools": "repository_root",
      "postgisTempValidation": "repository_root"
    },
    "exactHashRecordFields": ["query", "acquisitionReceipt", "normalizedSnapshot", "normalizationReceipt"],
    "extendedHashRecordFields": ["spatialIndex"],
    "rightsDecisionExactFields": ["path", "bytes", "sha256", "decisionId", "decisionVersion", "rightsState", "permissionPhase"],
    "sourceOfferExactFields": ["noticePath", "noticeBytes", "noticeSha256", "rawAndDerivedDatabasePaths", "transformationPath", "notice"],
