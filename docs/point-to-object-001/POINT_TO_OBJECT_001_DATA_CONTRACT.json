    "boundaryRule": "a single boundary candidate may resolve with BOUNDARY_CONTACT; multiple boundary candidates are ambiguous",
    "overflowRule": "more than 20 eligible candidates returns blocked/CANDIDATE_SET_OVERFLOW; truncation is prohibited",
    "nearestIdentity": "disabled for building/land-use identity; allowed only for explicit road/poi intent after a versioned tolerance is separately validated",
    "modelParticipation": false
  },
