    "requiredTopLevelFields": ["decisionId", "decisionVersion", "sourceId", "licenceId", "permissionPhase", "territory", "operativeEvidence", "permissions", "rightsState", "obligations", "limitations", "publicOverpassRuntimeAllowed"],
    "obligationItemExactFields": ["obligationId", "appliesTo", "requirement", "evidenceLocator"],
    "clearanceRule": "rightsState=cleared requires at least one fully serialized obligation and exact linked rights bytes before any case or root manifest may inherit clearance."
  },
  "resolverPolicy": {
    "version": "resolver-policy-p2o-v1.0.1",
    "coverage": "bbox prefilter plus exact boundary-inclusive covers test against hashed coverage polygon",
    "priority": ["server-verified candidate assertion", "exact interior candidates by intent/class policy", "boundary candidates", "intent-specific nearest line/point within frozen tolerance", "coordinate context"],
    "classPriority": { "building": ["building", "building_part"], "general_object": ["building", "building_part", "land_use"], "land_use": ["land_use"], "road": ["road_segment"], "poi": ["poi_place"] },
    "buildingIntentLandUseRule": "land_use is context only under building intent and cannot become a building identity",
