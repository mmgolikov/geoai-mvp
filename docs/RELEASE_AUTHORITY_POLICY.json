{
  "schemaVersion": "1.0",
  "authorityType": "repository_release_policy",
  "policyOwner": "GeoAI Release Engineering",
  "lastReviewedAt": "2026-07-31T23:00:00Z",
  "repositoryRole": "policy_schema_and_historical_evidence",
  "currentOperationalAuthority": "external_post_release_evidence",
  "productionActionRequiresExplicitApproval": true,
  "authorityPrecedence": [
    "github_default_branch_and_merge_state",
    "github_deployments_or_production_environment",
    "vercel_production_alias",
    "supabase_physical_schema_migration_and_data_state",
    "figma_approved_design_authority",
    "confluence_direct_current_page_and_approval_record",
    "google_drive_supporting_artifacts_only",
    "repository_historical_snapshot"
  ],
  "derivedAuthorityFiles": {
    "projectRegistry": "docs/GEOAI_PROJECT_REGISTRY_V1.json",
    "currentReleaseState": "docs/CURRENT_RELEASE_STATE.md",
    "verifiedSnapshot": "docs/LAST_VERIFIED_RELEASE_SNAPSHOT.json",
    "deltaProtocol": "docs/GEOAI_SOURCE_AUDIT_AND_DELTA_PROTOCOL_V1.md",
    "auditRunbook": "docs/GEOAI_AUTOMATED_QA_AND_AUDIT_RUNBOOK_V1.md"
  },
  "repositoryCiCapabilities": {
    "validatesPolicyAndSnapshotSchema": true,
    "validatesHistoricalCurrentDistinction": true,
    "validatesCrossFileReleaseConsistency": true,
    "validatesInternalBoundaries": true,
    "queriesLiveGithubState": false,
    "queriesLiveVercelState": false,
    "queriesLiveSupabaseState": false,
    "queriesLiveFigmaState": false,
    "queriesLiveConfluenceState": false,
    "queriesLiveGoogleDriveState": false,
    "validatesExternalTruth": false,
    "mayDeclareCurrentOperationalRuntime": false,
    "mayRecommendMergeAutomatically": false
  },
  "externalTruthGate": {
    "requiredSystems": [
      "github",
      "vercel",
      "supabase",
      "figma",
      "confluence",
      "google_drive"
    ],
    "freshDirectReadbackRequired": true,
    "requiredAfterExactHeadChecks": true,
    "requiredBeforeFounderMergeReview": true,
    "greenRepositoryCiSatisfiesGate": false
  },
  "confluenceReadSafety": {
    "searchSnippetsAreDiscoveryOnly": true,
    "searchSnippetsMayLag": true,
    "directCurrentPageVersionAndBodyAreAuthoritative": true
  },
  "requiredPostReleaseEvidenceFields": [
    "verifiedAt",
    "mergedPullRequest",
    "mainSha",
    "qualityGateRunId",
    "productionDeploymentId",
    "productionUrl",
    "productionStatus",
    "routeSmoke",
    "runtimeLogInspection",
    "dataHonestyCaveat"
  ],
  "snapshotRules": {
    "requiredAuthorityType": "historical_last_verified_snapshot",
    "supersededWhenNewerReleaseExists": true,
    "mustNeverBeLabelledCurrent": true,
    "externalReceiptMaySupersede": true,
    "mustNeverOverrideFresherPrimaryEvidence": true
  },
  "environmentRules": {
    "previewIsProduction": false,
    "readyDeploymentProvesRouteAndVisualQa": false,
    "mergedCodeProvesVerifiedDeployment": false,
    "migrationFileProvesAppliedSchema": false,
    "figmaApprovalProvesRuntimeImplementation": false,
    "internalConsistencyProvesExternalTruth": false
  },
  "protectedActions": [
    "merge",
    "mark_pr_ready",
    "enable_auto_merge",
    "production_deploy_or_promotion",
    "production_rollback",
    "supabase_migration_or_data_mutation",
    "auth_rls_grant_function_or_storage_change",
    "secret_or_environment_variable_change",
    "figma_mutation"
  ],
  "maturityClaimsForbidden": [
    "production-ready",
    "pilot-ready"
  ],
  "requiredCaveat": "Screening hypothesis; official validation required; not a legal, cadastral, zoning, planning or valuation conclusion."
}
