NEXT_PUBLIC_MAPBOX_TOKEN=
# Provider credentials are intentionally absent from the portable candidate.
# Keep OPENAI_API_KEY unset unless a separately authorized provider lane owns it.
OPENAI_MODEL=
OPENAI_MODEL_DECISION_SCORING=
NEXT_PUBLIC_SUPABASE_URL=
# Public browser-safe key. Legacy anon keys are not accepted by application runtime.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTH_MODE=demo_public
GEOAI_ACCESS_ENFORCEMENT_MODE=soft
GEOAI_REQUIRE_SUPABASE_READY=false
GEOAI_REQUIRE_STORAGE_READY=false
GEOAI_ALLOW_DEMO_PUBLIC=true
# Server-only; a key alone never activates upstream use and pre-AUTH generation still returns 403.
GEOAI_ALLOW_OPENAI_UPSTREAM=false
# Server-only; narrow exception for the access-controlled point-to-object Preview route only.
GEOAI_ALLOW_POINT_OBJECT_PREVIEW_AI=false
GEOAI_ALLOW_POINT_OBJECT_PREVIEW_PERSISTENCE=false
GEOAI_ENABLE_PREVIEW_SOURCE_PACK=false
# Required with the flag above; operator-only, 32+ random characters, never NEXT_PUBLIC_*.
GEOAI_OPERATOR_SOURCE_TOKEN=

# Portable self-host candidate. Do not set these on Vercel. The candidate must
# use its real runtime identity; never fake VERCEL_ENV.
GEOAI_BUILD_TARGET=
GEOAI_RUNTIME_TARGET=
GEOAI_PUBLIC_ORIGIN=
GEOAI_RELEASE_COMMIT_SHA=
GEOAI_PUBLIC_BUILD_FINGERPRINT=
NEXT_PUBLIC_GEOAI_BUILD_FINGERPRINT=
GEOAI_ALLOW_POINT_OBJECT_SELF_HOSTED_SURFACE=false
GEOAI_ALLOW_POINT_OBJECT_SELF_HOSTED_AI=false
GEOAI_ALLOW_POINT_OBJECT_SELF_HOSTED_PERSISTENCE=false
